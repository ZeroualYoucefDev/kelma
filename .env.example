# ---------------------------------------------------------------------------
# Kelma — environment template
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# Public application URL (no trailing slash). Used for OAuth callbacks,
# Chargily return URLs and absolute webhook registration.
NEXT_PUBLIC_APP_URL=http://localhost:3100

# ---------------------------------------------------------------------------
# SQLite persistence (zero-config local file)
# Optional: defaults to ./kelma.db. Use file:./data/kelma.db to customise.
# ---------------------------------------------------------------------------
DATABASE_URL=./kelma.db

# ---------------------------------------------------------------------------
# Clerk — Google SSO + one-time email codes (no passwords)
# Find these in the Clerk Dashboard -> API Keys / SSO Connections.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# After verification, users land directly in the dashboard — never on /.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/learn
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/learn

# ---------------------------------------------------------------------------
# Chargily Pay API v2 (DZD — CIB / Edahabia)
# test keys start with test_sk_, live keys with live_sk_
# ---------------------------------------------------------------------------
CHARGILY_API_KEY=test_sk_xxxxxxxxxxxxxxxxxxxx
# Secret used for HMAC-SHA256 webhook verification. If omitted, the API key is used.
CHARGILY_SECRET_KEY=test_sk_xxxxxxxxxxxxxxxxxxxx
CHARGILY_MODE=test
# Optional price ID created in the Chargily dashboard. When set, checkout uses
# the Price instead of an ad-hoc amount.
CHARGILY_PRO_PRICE_ID=
# Amount in DZD minor units (1000 = 10.00 DZD) when no Price ID is configured.
CHARGILY_PRO_AMOUNT_DZD=9900

# ---------------------------------------------------------------------------
# External language data (all optional — public endpoints with sane defaults)
# ---------------------------------------------------------------------------
LINGUISTICS_CACHE_TTL_SECONDS=86400
